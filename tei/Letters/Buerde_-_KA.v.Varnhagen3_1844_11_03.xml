                  <repository n="PL-Kj">
                     <orgName key="D0205">Biblioteka Jagiellońska</orgName> 
                  </repository>
                  <collection>Varnhagen von Ensesche Sammlung, katalogisiert von Ludwig Stern</collection>
                  <idno>Kasten 40</idno>
                  <msName>Jeannette Bürde, geb. Milder: 3 Briefe an Varnhagen 1833. 38. 44.</msName>
               </msIdentifier>
               <physDesc>
                  <p n="extent">1 Bl. (r: Brieftext, v: leer)</p>
                  <p>Briefbogen wurde einfach gefaltet, dann beschrieben und anschließend zu einem Umschlag gefaltet</p>
                  <p>weißes Papier</p>
                  <p>kein Wasserzeichen</p>
                  <p>Unterhalb des Empfängers dunkle Siegelreste</p>
                  <p>Linke untere Ecke (r) rundlich abgerissen</p>
                  <p>roter Stempel verso, im oberen Drittel in der Mitte des Bogens: <q>STAATSBIBLIOTHEK BERLIN</q></p>
                  <p>
                     <lb/>Von <persName key="A0203">Varnhagen</persName> mit dunkler Tinte:
                     <lb/>recto oben mitte: <persName key="A0101">Jeannette Bürde <hi rend="underline">geb. Milder</hi></persName>.
                     <lb/>recto oben rechts: <settlement key="B0101">Berlin</settlement>, den <date when="1844-11-03">3. November 1844</date>.
                  </p>
               </physDesc>
            </msDesc>
