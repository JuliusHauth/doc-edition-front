  <text type="letter">
      <body>
         <div type="address">
            <p>
               <address>
                  <addrLine>Sr Hochwohlgeboren</addrLine>
                  <addrLine>Des</addrLine>
                  <addrLine>Herrn <persName key="A0203">von <hi rend="latintype">Varnhagen</hi></persName>.</addrLine>
               </address>
            </p>
         </div>
         <div type="writingSession">
            <opener>
               <dateline rend="bottom of the text left">
                  <lb/>Sonntag am<date when="1844-11-03">3 <hi rend="#sup #underline"><unclear reason="illegible" resp="editor">tn</unclear></hi> Nov.
                  <lb rend="indent-3"/>1844</date>.
               </dateline>
               <salute><note type="commentary" resp="editor">Anrede fehlt.</note></salute>
            </opener>
            <p>
               <lb/>Die treffliche Freundin ihrer Freunde,
               <lb/><persName key="A0218">Friedericke <hi rend="latintype">Liman</hi></persName>, hat gestern Nachmittag
               <lb/>sanft, nach kurzer Krankheit ihre
               <lb/>irdische Laufbahn vollendet, welches
               <lb/>ich Ew Hochwohlgeboren hierdurch
               <lb/>gehorsamst anzeige
            </p>
            <gap reason="ornament"/>
               <closer>
                  <signed>
                     <lb/><persName key="A0101"><hi rend="latintype">Jeannette Bürde</hi>
                     <lb/>geb <hi rend="latintype">Milder</hi></persName>
                  </signed>
               </closer>
         </div>
      </body>
  </text>
